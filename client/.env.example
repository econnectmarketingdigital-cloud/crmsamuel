# URL do backend (em desenvolvimento local deixe vazio se usar proxy do Vite, ou aponte para http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Google OAuth Client ID (opcional - para login com Google)
VITE_GOOGLE_CLIENT_ID=

# Supabase (opcional no frontend - o upload já passa pelo backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
